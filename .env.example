# API base URL (no trailing slash)
API_BASE_URL=http://localhost:3000

# Plumpi Events API endpoint (no trailing slash)
PLUMPI_ENDPOINT=https://api-staging.plumpievents.com/v1
VITE_PLUMPI_WEB=https://2e81a86b.plumpi-web.pages.dev

# Session secret
SESSION_SECRET=super-secret-key-change-me
VITE_R2_PUBLIC_BASE_URL=R2_url_here

# The single origin allowed to open the OAuth popup (app/features/oauth) and receive its postMessage handoff
OAUTH_ALLOWED_ORIGIN=https://2e81a86b.plumpi-web.pages.dev

# YouTube Data API v3 key, used to read lesson video lengths
YOUTUBE_API_KEY=your_youtube_data_api_key

# The one canonical origin every canonical URL, og:url and sitemap entry is
# written against. Set it on any deployment reachable on more than one hostname
# (apex vs www, the Workers preview domain, a tunnel) so search engines do not
# split one page across several competing URLs. Falls back to the served origin.
SITE_URL=https://truekhmer.com

# Whether this deployment may be indexed. Unset, the hostname decides and
# anything that looks like staging, a preview or localhost is held out of the
# index -- so production needs this set explicitly to true.
SEO_INDEXABLE=false
